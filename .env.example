# 可选：全站访问密码。留空则不启用门禁；填写时至少 4 位。
SITE_PASSWORD=

# 可选：OpenAI Chat Completions 兼容模型。留空会禁用 AI 聊天。
# 注意只写 API_KEY=sk-...，不要写成 API_KEY==sk-... 或 API_KEY="Bearer sk-..."。
API_KEY=
API_ENDPOINT=https://api.deepseek.com/chat/completions
API_MODEL=deepseek-chat
AI_TIMEOUT_MS=30000

# 应用端口与 Docker Compose 对外端口
PORT=1314
HOST_PORT=1314

# Android APK 打开的网站地址。构建 APK 前填写，必须是 HTTPS 地址。
APP_URL=
